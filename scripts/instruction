#!/usr/bin/env bash

# ==============================================================================
# Шпаргалка по управлению кейсами и каталогом BADDROP
# Все команды выполняются в директории /opt/baddrop на сервере
# ==============================================================================

cd /opt/baddrop

# ------------------------------------------------------------------------------
# 1. ОБНОВЛЕНИЕ КЕЙСОВ (без изменения slug)
# Используй, если правишь цены, вероятности дропа в paytable, картинку
# существующего кейса или добавляешь НОВЫЙ кейс с уникальным slug.
# ------------------------------------------------------------------------------

# 1.1. Подтягиваем свежие коммиты из репозитория
git pull origin main

# 1.2. Пересобираем Docker-образ со свежей статикой (/imgs/cases/...)
./scripts/deploy.sh

# 1.3. Синхронизируем базу данных с файлом initial-cases.json
./scripts/sync.sh


# ------------------------------------------------------------------------------
# 2. ПОЛНЫЙ СБРОС И ПЕРЕЗАЛИВКА КАТАЛОГА (Hard Reset)
# Используй, когда менял slugs, удалял старые кейсы или делаешь полный редизайн,
# чтобы гарантированно избежать дубликатов старых кейсов на витрине.
# ------------------------------------------------------------------------------

# 2.1. Подтягиваем код
git pull origin main

# 2.2. Полная очистка таблицы cases в MySQL (с отключением внешних ключей)
docker exec -i baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db -e \
  "SET FOREIGN_KEY_CHECKS = 0; TRUNCATE TABLE cases; SET FOREIGN_KEY_CHECKS = 1;"

# 2.3. Пересобираем приложение с новыми ассетами
./scripts/deploy.sh

# 2.4. Заливаем чистый каталог из initial-cases.json с нуля
./scripts/sync.sh


# ------------------------------------------------------------------------------
# 3. БЫСТРЫЕ ОПЕРАТИВНЫЕ ПРАВКИ В MYSQL (без пересборки Docker)
# Быстрые точечные действия напрямую через базу данных.
# ------------------------------------------------------------------------------

# 3.1. Посмотреть текущий список всех кейсов в базе (ID, slug, имя, цена, статус)
docker exec -i baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db -e \
  "SELECT id, slug, name, price, is_active FROM cases;"

# 3.2. Временно отключить (скрыть) кейс с витрины маркетплейса
docker exec -i baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db -e \
  "UPDATE cases SET is_active = 0 WHERE slug = 'pepe-plastic';"

# 3.3. Включить скрытый кейс обратно
docker exec -i baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db -e \
  "UPDATE cases SET is_active = 1 WHERE slug = 'pepe-plastic';"

# 3.4. Быстро изменить цену кейса на лету
docker exec -i baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db -e \
  "UPDATE cases SET price = 1.50 WHERE slug = 'pepe-plastic';"

# 3.5. Удалить отдельный старый/устаревший кейс по его slug
docker exec -i baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db -e \
  "DELETE FROM cases WHERE slug = 'pepe-iron';"


# ------------------------------------------------------------------------------
# 4. ИНТЕРАКТИВНЫЙ ВХОД В БАЗУ ДАННЫХ
# Запуск консоли MySQL внутри контейнера для произвольных запросов.
# Для выхода ввести: exit;
# ------------------------------------------------------------------------------

docker exec -it baddrop_mysql mysql -u root -p'db_PAss_prod_msQL29' baddrop_db


# ------------------------------------------------------------------------------
# 5. ДИАГНОСТИКА И ЛОГИ
# Проверка состояния контейнеров и вывод логов Spring Boot при ошибках.
# ------------------------------------------------------------------------------

# 5.1. Проверить статус всех запущенных Docker-контейнеров
docker ps

# 5.2. Читать логи бэкенда в реальном времени (последние 100 строк)
docker logs -f --tail 100 baddrop_app